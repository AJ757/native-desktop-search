{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Native Desktop Search",
  "version": "0.1.1",
  "identifier": "com.dffpro.nativedesktopsearch",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Native Desktop Search",
        "width": 800,
        "height": 600,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
     "macOS": {
      "minimumSystemVersion": "13.4"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/aj757/native-desktop-search/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMwMEREQTU0MEUwOEE4QkMKUldTOHFBZ09WTm9OTU0xaUdkczVHRmtRMEh2cFl2cDdxK2xGRlFnOGYvaXJES05NOU53RnBlaDkK"
    }
  }
}
