# ---------- Google (Drive / Docs) ----------
# Create an OAuth client of type "Desktop app" in Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Microsoft (OneDrive / Microsoft 365) ----------
# Entra ID app registration, platform "Mobile and desktop applications"
MICROSOFT_CLIENT_ID=c6a48e54-c515-457e-8b28-90ef0dd8a37f
# "common" allows both personal and work/school accounts
MICROSOFT_TENANT=common

# ---------- Notion ----------
# Public integration from notion.so/my-integrations
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# ---------- OAuth loopback ----------
# Local port for the temporary 127.0.0.1 callback server.
# Use a fixed port if a provider requires the exact redirect URI to be registered.
OAUTH_LOOPBACK_PORT=53682

# ---------- API base URLs (override only for tests) ----------
# Leave blank to use the real APIs. CI points these at the Docker mock servers.
GOOGLE_API_BASE_URL=
MICROSOFT_API_BASE_URL=
NOTION_API_BASE_URL=

# ---------- Observability (optional) ----------
# Leave blank to disable crash reporting entirely
SENTRY_DSN=
RUST_LOG=info